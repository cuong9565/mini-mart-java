}\r\n        return true;\r\n    }\r\n\r\n    public String getError() {\r\n        return error;\r\n    }\r\n\r\n    public int getNumLine() {\r\n        return numLine;\r\n    }\r\n\r\n    public OfferDTO getOfferById(int id) {\r\n        for (OfferDTO of : list)\r\n            if (of.getId() == id)\r\n                return of;\r\n        return null;\r\n    }\r\n\r\n}\r\n
